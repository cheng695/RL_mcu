{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "process",
            "command": "bash",
            "args": ["scripts/build.sh", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash Debug (J-Link SWD)",
            "type": "process",
            "command": "${workspaceFolder}\\scripts\\flash.cmd",
            "args": ["Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"]
        }
    ]
}
